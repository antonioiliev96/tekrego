{
  "format": "page",
  "id": "blog_post",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Заглавие",
          "single": "heading1"
        },
        "type": "StructuredText"
      },
      "publication_date": {
        "config": {
          "label": "Дата на публикуване"
        },
        "type": "Date"
      },
      "category": {
        "config": {
          "label": "Категория",
          "options": [
            "Юмейхо терапия",
            "Масажи",
            "Биорезонанс",
            "Здраве и съвети",
            "Новини и промоции"
          ]
        },
        "type": "Select"
      },
      "cover_image": {
        "config": {
          "label": "Корична снимка"
        },
        "type": "Image"
      },
      "excerpt": {
        "config": {
          "label": "Кратко описание",
          "placeholder": "Кратко резюме, което се показва в списъка с публикации"
        },
        "type": "Text"
      },
      "body": {
        "config": {
          "allowTargetBlank": true,
          "label": "Съдържание",
          "multi": "heading2,heading3,paragraph,strong,em,hyperlink,list-item,o-list-item,image,preformatted"
        },
        "type": "StructuredText"
      },
      "slices": {
        "config": {
          "choices": {}
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Blog Post",
  "repeatable": true,
  "status": true
}