{
  "format": "page",
  "id": "blog_post",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Заглавие",
          "single": "heading1"
        },
        "type": "StructuredText"
      },
      "publication_date": {
        "config": {
          "label": "Дата на публикуване"
        },
        "type": "Date"
      },
      "category": {
        "config": {
          "label": "Категория",
          "options": [
            "Юмейхо терапия",
            "Масажи",
            "Биорезонанс",
            "Здраве и съвети",
            "Новини и промоции"
          ]
        },
        "type": "Select"
      },
      "cover_image": {
        "config": {
          "label": "Корична снимка"
        },
        "type": "Image"
      },
      "excerpt": {
        "config": {
          "label": "Кратко описание",
          "placeholder": "Кратко резюме, което се показва в списъка с публикации"
        },
        "type": "Text"
      },
      "body": {
        "config": {
          "allowTargetBlank": true,
          "label": "Съдържание",
          "multi": "heading2,heading3,paragraph,strong,em,hyperlink,list-item,o-list-item,image,preformatted"
        },
        "type": "StructuredText"
      },
      "slices": {
        "config": {
          "choices": {}
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "SEO заглавие (до 35 знака)",
          "placeholder": "Ако е празно, се използва заглавието на статията"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "SEO описание (до 155 знака)",
          "placeholder": "Ако е празно, се използва краткото описание"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Снимка за споделяне (1200×630)",
          "placeholder": "Ако е празно, се използва корицата",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Blog Post",
  "repeatable": true,
  "status": true
}